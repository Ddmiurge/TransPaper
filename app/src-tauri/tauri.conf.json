{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TransPaper",
  "version": "0.1.0",
  "identifier": "com.ddmiurge.transpaper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "论文阅读器",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "category": "Productivity",
    "shortDescription": "本地优先的论文阅读与翻译工具"
  }
}
